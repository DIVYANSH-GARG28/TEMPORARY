# PostgreSQL Database Connection String
# DO NOT USE the default postgres:postgres in production! Use a strong password and host.
DATABASE_URL=postgresql://user:password@hostname:5432/geosync

# API Key for securing destructive endpoints (/reset and /area)
# Must match the API Key configured in the frontend deployment
API_KEY=your_secure_api_key_here

# Optional: Overpass API endpoints (if you want to override defaults)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
