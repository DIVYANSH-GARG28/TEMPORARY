{
  "name": "GeoSync Surveyor Bot (Real Data)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "trigger-node",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.text }}",
              "value2": "/cases"
            }
          ]
        }
      },
      "id": "switch-cases",
      "name": "Is /cases command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.message.location ? true : false }}",
              "value2": true
            }
          ]
        }
      },
      "id": "switch-location",
      "name": "Is Location sharing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        420
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://seven-vans-wear.loca.lt/api/telegram/cases?user_id=' + $json.message.chat.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Bypass-Tunnel-Reminder",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "http-cases",
      "name": "Fetch Real Cases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://seven-vans-wear.loca.lt/api/telegram/location",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Bypass-Tunnel-Reminder",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"latitude\": $json.message.location.latitude, \"longitude\": $json.message.location.longitude, \"user_id\": $json.message.chat.id.toString() } }}",
        "options": {}
      },
      "id": "http-location",
      "name": "Verify Real Location",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "send-cases",
      "name": "Send Cases",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        920,
        100
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.audit_message }}",
        "additionalFields": {}
      },
      "id": "send-location",
      "name": "Send Location Result",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        920,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Welcome to the <b>GeoSync Anti-Corruption Field Bot</b> 🗺️\n\nPlease select an option or send your live location to verify your coordinates against the database:\n\n👉 /cases - View your pending field assignments\n📍 <b>[Share Live Location]</b> - Perform a strict GPS boundary check",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "send-menu",
      "name": "Send Menu",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        920,
        540
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Is /cases command?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is /cases command?": {
      "main": [
        [
          {
            "node": "Fetch Real Cases",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Is Location sharing?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Location sharing?": {
      "main": [
        [
          {
            "node": "Verify Real Location",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Menu",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Real Cases": {
      "main": [
        [
          {
            "node": "Send Cases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Real Location": {
      "main": [
        [
          {
            "node": "Send Location Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}
