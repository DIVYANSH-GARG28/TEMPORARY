{
  "name": "GeoSync Surveyor Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "b1b2c3d4-e5f6-4a5b-8c7d-9e0f1a2b3c4d",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message.text }}",
              "value2": "/cases"
            }
          ]
        }
      },
      "id": "c2c3d4e5-f6a7-5b6c-9d8e-0f1a2b3c4d5e",
      "name": "Is /cases command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.message.location ? true : false }}",
              "value2": true
            }
          ]
        }
      },
      "id": "d3d4e5f6-a7b8-6c7d-0e1f-2a3b4c5d6e7f",
      "name": "Is Location sharing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        400,
        420
      ]
    },
    {
      "parameters": {
        "url": "={{ 'http://localhost:8000/api/telegram/cases?user_id=' + $json.message.chat.id }}",
        "options": {}
      },
      "id": "e4e5f6a7-b8c9-7d8e-1f2a-3b4c5d6e7f8a",
      "name": "Fetch Cases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        640,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/telegram/location",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"latitude\": $json.message.location.latitude, \"longitude\": $json.message.location.longitude, \"user_id\": $json.message.chat.id.toString() } }}",
        "options": {}
      },
      "id": "f5f6a7b8-c9d0-8e9f-2a3b-4c5d6e7f8a9b",
      "name": "Verify Location",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        640,
        420
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "a6a7b8c9-d0e1-9f0a-3b4c-5d6e7f8a9b0c",
      "name": "Send Cases",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        860,
        80
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.audit_message }}",
        "additionalFields": {}
      },
      "id": "b7b8c9d0-e1f2-0a1b-4c5d-6e7f8a9b0c1d",
      "name": "Send Audit Result",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        860,
        420
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Is /cases command?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is /cases command?": {
      "main": [
        [
          {
            "node": "Fetch Cases",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Is Location sharing?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Location sharing?": {
      "main": [
        [
          {
            "node": "Verify Location",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Cases": {
      "main": [
        [
          {
            "node": "Send Cases",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Location": {
      "main": [
        [
          {
            "node": "Send Audit Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}
